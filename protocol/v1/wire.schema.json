{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://9aia.com/pavo/protocol/v1/wire.schema.json",
  "title": "pavo v1 wire ops",
  "description": "ndjson JSON-RPC request/response envelope and op payloads. Mirrors crates/pavo-protocol/src/wire.rs. Same convention as tamias-serve / myco serve / cuora serve / sepia serve. Additive-only within v1.",
  "defs": {
    "request": {
      "description": "One request per line: {\"op\":\"…\", …}.",
      "oneOf": [
        {
          "type": "object",
          "required": ["op"],
          "properties": { "op": { "const": "manifest" } }
        },
        {
          "type": "object",
          "required": ["op"],
          "properties": { "op": { "const": "views" } }
        },
        {
          "type": "object",
          "required": ["op", "view"],
          "properties": {
            "op": { "const": "view" },
            "view": { "type": "string", "description": "View id from the driver's manifest." },
            "params": {
              "type": "object",
              "description": "Caller-supplied params merged into each query binding."
            }
          }
        },
        {
          "type": "object",
          "required": ["op", "query"],
          "properties": {
            "op": { "const": "query" },
            "query": {
              "type": "string",
              "description": "Query binding name, or a raw product op for thin drivers."
            },
            "params": { "type": "object" }
          }
        },
        {
          "type": "object",
          "required": ["op", "kind", "node", "data", "surface"],
          "properties": {
            "op": { "const": "render" },
            "kind": {
              "type": "string",
              "description": "The node's kind being rendered (e.g. \"graph\")."
            },
            "node": {
              "type": "object",
              "description": "The ViewNode serialized verbatim — unknown/future fields survive to the renderer plugin."
            },
            "data": {
              "type": "object",
              "description": "The view's data map (query bindings resolved by the host)."
            },
            "surface": {
              "type": "string",
              "enum": ["cli", "tui", "web"],
              "description": "Which surface is asking — renderers may answer different models per surface."
            },
            "format": {
              "type": "string",
              "description": "Optional format hint (e.g. \"svg\", \"ascii\"); absent for surface-default output."
            }
          }
        }
      ]
    },
    "renderModel": {
      "description": "Canonical render output of a `render` op — internally tagged on \"type\". Small on purpose: rows/table, svg island, text lines, or a named placeholder component. No HTML. Unknown `type` values degrade to placeholder on every surface.",
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "headers"],
          "properties": {
            "type": { "const": "rows" },
            "headers": { "type": "array", "items": { "type": "string" } },
            "aligns": {
              "type": "array",
              "items": { "type": "string", "enum": ["left", "center", "right"] },
              "default": []
            },
            "rows": {
              "type": "array",
              "items": { "type": "array", "items": { "type": "string" } },
              "default": []
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "markup"],
          "properties": {
            "type": { "const": "svg" },
            "markup": { "type": "string", "description": "Self-contained <svg>…</svg> fragment." }
          }
        },
        {
          "type": "object",
          "required": ["type", "lines"],
          "properties": {
            "type": { "const": "text" },
            "lines": { "type": "array", "items": { "type": "string" } }
          }
        },
        {
          "type": "object",
          "required": ["type", "component"],
          "properties": {
            "type": { "const": "placeholder" },
            "component": { "type": "string" },
            "props": { "type": "object", "default": {} }
          }
        }
      ]
    },
    "response": {
      "type": "object",
      "required": ["ok"],
      "properties": {
        "ok": { "type": "boolean" },
        "result": {
          "description": "Result payload when ok is true (absent otherwise)."
        },
        "error": {
          "type": "string",
          "description": "Error string when ok is false (absent otherwise)."
        }
      }
    },
    "viewSummary": {
      "type": "object",
      "required": ["id", "title", "route"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "route": { "type": "string" },
        "description": { "type": ["string", "null"] },
        "queries": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    },
    "viewResult": {
      "type": "object",
      "required": ["view"],
      "properties": {
        "view": { "$ref": "driver-manifest.schema.json#/$defs/viewSpec" },
        "data": {
          "type": "object",
          "description": "Query results keyed by binding name; failures appear as {\"error\": \"…\"} payloads."
        }
      }
    },
    "queryResult": {
      "type": "object",
      "required": ["query", "data"],
      "properties": {
        "query": { "type": "string" },
        "data": { "description": "Driver/product-defined payload, passed through verbatim." }
      }
    }
  }
}
