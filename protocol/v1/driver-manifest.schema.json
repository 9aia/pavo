{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://9aia.com/pavo/protocol/v1/driver-manifest.schema.json",
  "title": "pavo v1 driver manifest",
  "description": "What a tamias-driver-<type> executable answers to the `manifest` verb. Mirrors crates/pavo-protocol/src/manifest.rs. Additive-only within v1.",
  "type": "object",
  "required": ["name", "title", "version"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Driver name — the <type> in tamias-driver-<type>; namespaces routes as /<name>/<view>."
    },
    "title": {
      "type": "string",
      "description": "Human-facing title for chrome."
    },
    "icon": {
      "type": ["string", "null"],
      "description": "Optional icon — emoji, icon name, or renderer-resolvable path."
    },
    "version": {
      "type": "string",
      "description": "Driver version (semver string)."
    },
    "verbs": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "Wire verbs beyond the tamias install verbs — e.g. [\"manifest\", \"serve\"]."
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "Capability tags — \"pavo\", \"config\", \"chrome\", …"
    },
    "contributes": { "$ref": "#/$defs/contributes" },
    "views": {
      "type": "array",
      "items": { "$ref": "#/$defs/viewSpec" },
      "default": []
    }
  },
  "$defs": {
    "contributes": {
      "type": "object",
      "description": "Contribution slots — navbar, dashboard, statusbar, routes, plus forward-compat extras.",
      "properties": {
        "navbar": { "type": "array", "items": { "$ref": "#/$defs/contribution" }, "default": [] },
        "dashboard": { "type": "array", "items": { "$ref": "#/$defs/contribution" }, "default": [] },
        "statusbar": { "type": "array", "items": { "$ref": "#/$defs/contribution" }, "default": [] },
        "routes": { "type": "array", "items": { "$ref": "#/$defs/contribution" }, "default": [] }
      },
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/$defs/contribution" }
      }
    },
    "contribution": {
      "type": "object",
      "required": ["id", "title", "route"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable id — namespaced <driver>:<id> by convention."
        },
        "title": { "type": "string" },
        "route": {
          "type": "string",
          "description": "Host-relative route the entry navigates to."
        },
        "priority": {
          "type": "integer",
          "default": 100,
          "description": "Ordering hint within the slot; lower sorts first."
        },
        "icon": { "type": ["string", "null"] }
      }
    },
    "viewSpec": {
      "type": "object",
      "required": ["id", "title", "route", "root"],
      "properties": {
        "id": { "type": "string", "description": "View id, unique within the driver." },
        "title": { "type": "string" },
        "route": {
          "type": "string",
          "description": "Route the view answers — <driver>:<view> deep links resolve here."
        },
        "description": { "type": ["string", "null"] },
        "queries": {
          "type": "array",
          "items": { "$ref": "#/$defs/queryBinding" },
          "default": []
        },
        "root": { "$ref": "view-node.schema.json" }
      }
    },
    "queryBinding": {
      "type": "object",
      "required": ["name", "op"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Binding name — referenced by `query` fields in the tree."
        },
        "op": {
          "type": "string",
          "description": "Wire op to invoke on the driver's serve."
        },
        "params": {
          "type": "object",
          "description": "Static params merged into every invocation."
        }
      }
    }
  }
}
