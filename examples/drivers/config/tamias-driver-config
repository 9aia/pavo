#!/usr/bin/env python3
"""tamias-driver-config — generic config viewer/editor driver.

Answers `config:show` — a KV tree of the resolved pavo config plus a
source list — and `get`/`set` queries that read/write the config file.

Config resolution order (first hit wins):

    1. `--config <path>` argument (manual `serve` invocations; pavo's
       spawned `serve` can't pass argv, so this is for direct use)
    2. `PAVO_CONFIG` environment variable
    3. `~/.config/pavo/config.toml`
    4. `~/.config/pavo/config.json`
    5. built-in defaults (DEFAULTS below)

Formats: TOML (via stdlib `tomllib`, Python 3.11+) and JSON. YAML is
*not* supported — the stdlib has no YAML parser; see the README.
"""

import json
import os
import sys

try:
    import tomllib
except ImportError:  # Python < 3.11
    tomllib = None

NAME = "config"

DEFAULTS = {
    "theme": "dark",
    "statusbar": True,
    "refresh_ms": 5000,
}

# ------------------------------------------------------------ resolution


def config_candidates():
    """Ordered (source_name, path) candidates that exist on disk."""
    out = []

    def add(name, path):
        if path:
            out.append((name, os.path.expanduser(path)))

    # --config may appear anywhere in argv (serve included).
    argv = sys.argv[1:]
    for i, arg in enumerate(argv):
        if arg == "--config" and i + 1 < len(argv):
            add("--config", argv[i + 1])
        elif arg.startswith("--config="):
            add("--config", arg.split("=", 1)[1])
    add("PAVO_CONFIG", os.environ.get("PAVO_CONFIG"))
    home = os.path.expanduser("~/.config/pavo")
    add("~/.config/pavo/config.toml", os.path.join(home, "config.toml"))
    add("~/.config/pavo/config.json", os.path.join(home, "config.json"))
    return out


def resolve_path():
    """First existing candidate, else the first candidate (for `set`
    to have somewhere to write) — documenting intent in README."""
    cands = config_candidates()
    for _, path in cands:
        if os.path.isfile(path):
            return path
    # Nothing exists: prefer the env/default location so `set` can
    # create it rather than failing.
    for name, path in cands:
        if name in ("PAVO_CONFIG", "~/.config/pavo/config.toml"):
            return path
    return cands[0][1] if cands else os.path.expanduser(
        "~/.config/pavo/config.toml"
    )


def load_file(path):
    """-> (data, kind) or raises ValueError with a user-facing msg."""
    if not os.path.isfile(path):
        return {}, "missing"
    with open(path, "rb") as f:
        raw = f.read()
    lower = path.lower()
    if lower.endswith(".json"):
        try:
            return json.loads(raw), "json"
        except Exception as e:
            raise ValueError("invalid JSON in %s: %s" % (path, e))
    if lower.endswith((".yaml", ".yml")):
        raise ValueError("YAML is not supported (no stdlib parser) — use TOML or JSON")
    if lower.endswith(".toml"):
        kind = "toml"
    elif raw.lstrip()[:1] in (b"{", b"["):
        kind = "json"
    else:
        kind = "toml"
    if kind == "json":
        try:
            return json.loads(raw), "json"
        except Exception as e:
            raise ValueError("invalid JSON in %s: %s" % (path, e))
    if tomllib is None:
        raise ValueError("TOML support requires Python 3.11+ (tomllib)")
    try:
        return tomllib.loads(raw.decode("utf-8")), "toml"
    except Exception as e:
        raise ValueError("invalid TOML in %s: %s" % (path, e))


def flatten(obj, prefix=""):
    """Nested dict -> dotted-key flat map (lists/values stay atomic)."""
    out = {}
    if isinstance(obj, dict):
        for k, v in obj.items():
            key = "%s.%s" % (prefix, k) if prefix else str(k)
            if isinstance(v, dict):
                out.update(flatten(v, key))
            else:
                out[key] = v
    return out


def deep_get(obj, dotted):
    cur = obj
    for part in dotted.split("."):
        if not isinstance(cur, dict) or part not in cur:
            return None, False
        cur = cur[part]
    return cur, True


def resolved():
    """(merged_flat, sources, path, file_data) for the show view."""
    path = resolve_path()
    sources = []
    file_data = {}
    file_kind = "missing"
    try:
        file_data, file_kind = load_file(path)
    except ValueError as e:
        sources.append({"source": path, "kind": "error", "detail": str(e)})
    else:
        if file_kind != "missing":
            sources.append({
                "source": path,
                "kind": file_kind,
                "keys": len(flatten(file_data)),
            })
    merged = dict(DEFAULTS)
    merged.update(file_data)
    return flatten(merged), sources, path, file_data, file_kind


def toml_value(v):
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)):
        return repr(v)
    if isinstance(v, str):
        return json.dumps(v)
    return json.dumps(v)


def write_back(path, key, value, kind):
    """Write a *top-level* key back to the config file. Returns err or None."""
    if "." in key:
        return "set supports top-level keys only (got %r)" % key
    if kind == "json":
        data, _ = load_file(path)
        data[key] = value
        os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2)
            f.write("\n")
        return None
    # TOML: replace an existing top-level `key = ...` line, else insert
    # before the first [section] header (top-level keys must precede
    # tables in TOML).
    try:
        with open(path, "r", encoding="utf-8") as f:
            lines = f.readlines()
    except FileNotFoundError:
        lines = []
    prefix = key + " "
    new_line = "%s = %s\n" % (key, toml_value(value))
    replaced = False
    insert_at = len(lines)
    for i, line in enumerate(lines):
        stripped = line.strip()
        if stripped.startswith("[") and insert_at == len(lines):
            insert_at = i
        if not stripped or stripped.startswith("#"):
            continue
        if stripped.startswith(prefix) or stripped.startswith(key + "="):
            # crude top-level check: no leading whitespace, no '.' in key
            if not line[:1].isspace():
                lines[i] = new_line
                replaced = True
                break
    if not replaced:
        lines.insert(insert_at, new_line)
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.writelines(lines)
    return None


# ---------------------------------------------------------------- views

def show_data():
    flat, sources, path, _, _ = resolved()
    return {"config": flat, "sources": sources, "path": path}


VIEWS = [
    {
        "id": "show",
        "title": "Config",
        "route": "/config",
        "description": "Resolved pavo config (KV) plus where it came from.",
        "queries": [
            {"name": "config", "op": "query", "params": {"query": "config"}},
            {"name": "sources", "op": "query", "params": {"query": "sources"}},
        ],
        "root": {
            "kind": "column",
            "title": "Config",
            "children": [
                {"kind": "kv", "title": "Resolved", "query": "config", "pairs": []},
                {
                    "kind": "table",
                    "title": "Sources",
                    "query": "sources",
                    "columns": [
                        {"key": "source", "title": "Source"},
                        {"key": "kind", "title": "Kind", "width": 8},
                        {"key": "keys", "title": "Keys", "width": 6},
                    ],
                },
                {
                    "kind": "markdown",
                    "text": "Resolution: `--config` > `PAVO_CONFIG` > "
                            "`~/.config/pavo/config.toml` > defaults. "
                            "TOML + JSON only (no YAML in stdlib).",
                },
            ],
        },
    }
]

MANIFEST = {
    "name": NAME,
    "title": "Config",
    "icon": "⚙",
    "version": "0.1.0",
    "verbs": ["manifest", "serve"],
    "capabilities": ["pavo", "config"],
    "contributes": {
        "statusbar": [
            {"id": "status", "title": "config", "route": "/config", "priority": 90},
        ],
    },
    "views": VIEWS,
}


def summary(spec):
    return {
        "id": spec["id"],
        "title": spec["title"],
        "route": spec["route"],
        "description": spec.get("description"),
        "queries": [b["name"] for b in spec.get("queries", [])],
    }


def query_data(name, params):
    if name == "config":
        flat, _, _, _, _ = resolved()
        return flat
    if name == "sources":
        _, sources, path, _, _ = resolved()
        # always surface the resolved path even when nothing exists
        if not any(s.get("source") == path for s in sources):
            sources = sources + [{"source": path, "kind": "missing", "keys": 0}]
        return sources
    if name == "get":
        key = params.get("key")
        if not key:
            return {"error": "get requires params.key"}
        flat, _, _, _, _ = resolved()
        if key in flat:
            return {"key": key, "value": flat[key], "found": True}
        return {"key": key, "value": None, "found": False}
    if name == "set":
        key = params.get("key")
        if not key or "value" not in params:
            return {"error": "set requires params.key and params.value"}
        _, _, path, _, kind = resolved()
        if kind == "missing":
            kind = "toml" if path.endswith(".toml") else "json"
        err = write_back(path, str(key), params["value"], kind)
        if err:
            return {"error": err}
        return {"key": key, "value": params["value"], "path": path, "written": True}
    return None


# ---------------------------------------------------------------- wire

def emit(obj):
    sys.stdout.write(json.dumps(obj, separators=(",", ":")) + "\n")
    sys.stdout.flush()


def respond_ok(result):
    emit({"ok": True, "result": result})


def respond_err(msg):
    emit({"ok": False, "error": str(msg)})


def view_result(view_id):
    for spec in VIEWS:
        if spec["id"] == view_id:
            data = {}
            for binding in spec.get("queries", []):
                qname = binding.get("params", {}).get("query", binding["name"])
                payload = query_data(qname, {})
                if isinstance(payload, dict) and payload.get("error"):
                    data[binding["name"]] = payload
                else:
                    data[binding["name"]] = payload
            return {"view": spec, "data": data}
    return None


def dispatch(obj):
    op = obj.get("op")
    params = obj.get("params") or {}
    if op == "manifest":
        respond_ok(MANIFEST)
    elif op == "views":
        respond_ok([summary(v) for v in VIEWS])
    elif op == "view":
        result = view_result(obj.get("view"))
        if result is None:
            respond_err("unknown view: %s" % obj.get("view"))
        else:
            respond_ok(result)
    elif op == "query":
        name = obj.get("query")
        payload = query_data(name, params)
        if payload is None:
            respond_err("unknown query: %s" % name)
        else:
            respond_ok({"query": name, "data": payload})
    else:
        respond_err("unknown op: %s" % op)


def serve():
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            obj = json.loads(line)
        except Exception:
            respond_err("invalid JSON request")
            continue
        if not isinstance(obj, dict):
            respond_err("request must be a JSON object")
            continue
        dispatch(obj)
    return 0


def main():
    args = sys.argv[1:]
    if not args:
        sys.stderr.write("usage: tamias-driver-config manifest|capabilities|serve [--config PATH]\n")
        return 1
    verb = args[0]
    if verb == "manifest":
        sys.stdout.write(json.dumps(MANIFEST, indent=2) + "\n")
        return 0
    if verb == "capabilities":
        sys.stdout.write(json.dumps({
            "capabilities": MANIFEST["capabilities"],
            "verbs": MANIFEST["verbs"],
        }) + "\n")
        return 0
    if verb == "serve":
        return serve()
    return 1


if __name__ == "__main__":
    sys.exit(main())
