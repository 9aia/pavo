MANIFEST_ACTIONS = [
    ACTION_REFRESH,
    ACTION_NEW,
    ACTION_DONE,
    ACTION_ARCHIVE,
    ACTION_DELETE,
]

# Per-row actions on backlog tree items (same ids — the driver
# resolves them against the invoke request's `view`/`target`).
ITEM_ACTIONS = [
    ACTION_DONE,
    ACTION_ARCHIVE,
    ACTION_DELETE,
]

# ---------------------------------------------------------------- queries

def counts():
    out = {}
    for t in TASKS:
        out[t["status"]] = out.get(t["status"], 0) + 1
    out["total"] = len(TASKS)
    return out


def tree_items():
    """Backlog tree rows — built per render so mutations show up."""
    items = []
    for t in TASKS:
        detail = "%s · %s · score %s" % (
            t["kind"], t["assignee"], t["score"])
        if t["blocked"]:
            detail += " · blocked"
        items.append({
            "id": t["id"],
            "label": t["title"],
            "detail": detail,
            "icon": "🟥" if t["blocked"] else "⬜",
            "actions": ITEM_ACTIONS,
        })
    return items


QUERIES = {
    "tasks": TASKS,
    "members": MEMBERS,
    "items": {"items": tree_items()},
    "counts": counts(),
}


def query_data(name, params):
    if name == "counts":
        return counts()
    if name == "items":
        return {"items": tree_items()}
    if name == "task":
        task = find_task(str(params.get("id", "")))
        return task if task else {"error": "unknown task %s" % params.get("id")}
    if name == "tasks":
        rows = TASKS
        if params.get("status"):
            wanted = params["status"]
            rows = [t for t in rows if t["status"] == wanted]
        if params.get("q"):
            needle = str(params["q"]).lower()
            rows = [t for t in rows
                    if needle in t["title"].lower() or needle in t["id"].lower()]
        return rows
    return QUERIES.get(name)


# ---------------------------------------------------------------- views

def q(name):
    return {"name": name, "op": "query", "params": {}}


VIEWS = [
