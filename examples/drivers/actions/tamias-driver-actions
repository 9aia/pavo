def summary(spec):
    return {
        "id": spec["id"],
        "title": spec["title"],
        "route": spec["route"],
        "description": spec.get("description"),
        "queries": [b["name"] for b in spec.get("queries", [])],
    }


def view_result(view_id, params):
    for spec in VIEWS:
        if spec["id"] == view_id:
            data = {}
            for binding in spec.get("queries", []):
                data[binding["name"]] = query_data(binding["name"], params)
            return {"view": spec, "data": data}
    return None


def find_task(task_id):
    return next((t for t in TASKS if t["id"] == task_id), None)


def next_id():
    nums = [int(t["id"].split("-")[1]) for t in TASKS
            if t["id"].startswith("A-")]
    return "A-%03d" % (max(nums, default=0) + 1)


# ---------------------------------------------------------------- invoke

def target_id(target):
    """Extract a task id from an opaque invoke target — accepts a
    bare id string, {"id": …}, or a row object carrying `id`."""
    if isinstance(target, str):
        return target
    if isinstance(target, dict):
        if isinstance(target.get("id"), str):
            return target["id"]
        item = target.get("item")
        if isinstance(item, dict) and isinstance(item.get("id"), str):
            return item["id"]
        if isinstance(item, str):
            return item
    return None


def required_errors(action_params, params):
    errors = {}
    for p in action_params:
        v = params.get(p["name"])
        if p.get("required") and (v is None or v == ""):
            errors[p["name"]] = "required"
    return errors


def fresh_view(view_id):
    """Re-render the invoking view (or the board) after a mutation."""
    vid = view_id if view_id in (v["id"] for v in VIEWS) else "board"
    return view_result(vid, {})


def invoke_result(view_id, action_id, target, params):
    """The `invoke` op — dispatch on the action id.

    Returns (ok, payload): payload is an ActionResult dict on ok,
    or an error string. Mutations return a fresh `view` so hosts
    re-render — the refresh-after-mutation contract.
    """
    params = params or {}

    if action_id == "refresh":
        return True, {"message": "refreshed", "view": fresh_view(view_id)}

    if action_id == "board.export":
        fmt = params.get("format") or "json"
        if fmt not in ("json", "csv", "md"):
            return True, {"errors": {"format": "invalid option"}}
        return True, {
            "message": "exported %d tasks as %s" % (len(TASKS), fmt),
            "data": {"format": fmt, "count": len(TASKS)},
        }

    if action_id == "task.new":
        spec = next(a for a in MANIFEST_ACTIONS if a["id"] == "task.new")
        errors = required_errors(spec["params"], params)
        kind = params.get("kind") or "chore"
        if kind not in KINDS:
            errors["kind"] = "invalid option"
        if "assignee" in params and params["assignee"] not in (
                m["id"] for m in MEMBERS):
            errors["assignee"] = "unknown member"
        if errors:
            return True, {"errors": errors}
        title = (params.get("title") or "").strip()
        if not title:
            return True, {"errors": {"title": "required"}}
        task = {
            "id": next_id(),
            "title": title,
            "status": "open",
            "kind": kind,
            "assignee": params.get("assignee"),
            "due": params.get("due"),
            "score": params.get("score", 5),
            "estimate": params.get("estimate", 1),
            "blocked": bool(params.get("blocked", False)),
            "tags": params.get("tags") or [],
            "notes": params.get("notes"),
        }
        TASKS.append(task)
        return True, {
            "message": "added %s" % task["id"],
            "data": {"task": task, "total": len(TASKS)},
            "view": fresh_view(view_id),
        }

    # Item-scoped actions — target carries the task id.
    if action_id not in ("task.done", "task.archive", "task.delete"):
        return False, "unknown action: %s" % action_id
    tid = target_id(target)
    if not tid:
        return True, {"errors": {"target": "missing task id"}}
    task = find_task(tid)
    if task is None:
        return True, {"errors": {"target": "unknown task %s" % tid}}

    if action_id == "task.done":
        task["status"] = "done"
        return True, {
            "message": "marked %s done" % tid,
            "data": {"task": task},
            "view": fresh_view(view_id),
        }

    if action_id == "task.archive":
        TASKS.remove(task)
        return True, {
            "message": "archived %s" % tid,
            "data": {"id": tid, "remaining": len(TASKS)},
            "view": fresh_view(view_id),
        }

    if action_id == "task.delete":
        errors = required_errors(
            next(a for a in MANIFEST_ACTIONS
                 if a["id"] == "task.delete")["params"], params)
        # `reason` is optional — nothing required; kept to show the
        # per-param errors path on item actions too.
        if errors:
            return True, {"errors": errors}
        TASKS.remove(task)
        return True, {
            "message": "deleted %s" % tid,
            "data": {"id": tid, "reason": params.get("reason"),
                     "remaining": len(TASKS)},
            "view": fresh_view(view_id),
        }

    return False, "unknown action: %s" % action_id


# ---------------------------------------------------------------- wire

def emit(obj):
    sys.stdout.write(json.dumps(obj, separators=(",", ":")) + "\n")
    sys.stdout.flush()


def respond_ok(result):
    emit({"ok": True, "result": result})


def respond_err(msg):
    emit({"ok": False, "error": str(msg)})


def dispatch(obj):
    op = obj.get("op")
    if op == "manifest":
        respond_ok(MANIFEST)
    elif op == "views":
        respond_ok([summary(v) for v in VIEWS])
    elif op == "view":
        result = view_result(obj.get("view"), obj.get("params") or {})
        if result is None:
            respond_err("unknown view: %s" % obj.get("view"))
        else:
            respond_ok(result)
    elif op == "query":
        name = obj.get("query")
        respond_ok({"query": name,
                    "data": query_data(name, obj.get("params") or {})})
    elif op == "invoke":
        ok, payload = invoke_result(
            obj.get("view"), obj.get("action"),
            obj.get("target"), obj.get("params") or {})
        if ok:
            respond_ok(payload)
        else:
            respond_err(payload)
    else:
        respond_err("unknown op: %s" % op)


def serve():
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            obj = json.loads(line)
        except Exception:
            respond_err("invalid JSON request")
            continue
        if not isinstance(obj, dict):
            respond_err("request must be a JSON object")
            continue
        dispatch(obj)
    return 0


def main():
    args = sys.argv[1:]
    if not args:
        sys.stderr.write(
            "usage: tamias-driver-actions manifest|capabilities|serve\n")
        return 1
    verb = args[0]
    if verb == "manifest":
        sys.stdout.write(json.dumps(MANIFEST, indent=2) + "\n")
        return 0
    if verb == "capabilities":
        sys.stdout.write(json.dumps({
            "capabilities": MANIFEST["capabilities"],
            "verbs": MANIFEST["verbs"],
        }) + "\n")
        return 0
    if verb == "serve":
        return serve()
    return 1


if __name__ == "__main__":
    sys.exit(main())
