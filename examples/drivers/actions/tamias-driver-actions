KINDS = ["bug", "feature", "chore"]
STATUSES = ["open", "wip", "done"]


# ---------------------------------------------------------------- actions

def act(action_id, label, **kw):
    """Action dict — same shape as pavo_protocol::Action."""
    a = {"id": action_id, "label": label}
    a.update(kw)
    return a


def param(name, kind="string", **kw):
    """ParamSchema dict — `kind` is one of the ParamKind spellings."""
    p = {"name": name, "kind": kind}
    p.update(kw)
    return p


# Manifest-global actions — offered on every view.
ACTION_REFRESH = act(
    "refresh", "Refresh", icon="reload", keys=["r"],
    description="Re-run the view's queries.",
)

ACTION_NEW = act(
    "task.new", "New task", icon="plus", keys=["n"],
    description="Add a task — every ParamKind in one auto-form.",
    params=[
        param("title", "string", required=True,
              placeholder="what needs doing?"),
        param("notes", "text", doc="Multi-line details."),
        param("kind", "enum", options=KINDS, default="chore",
              doc="Task kind."),
        param("assignee", "ref", ref_query="members", required=True,
              doc="Picked from the members query binding."),
        param("due", "date", hint="YYYY-MM-DD"),
        param("score", "number", min=0, max=10,
              doc="Priority score, 0–10."),
        param("estimate", "integer", min=1, max=21,
